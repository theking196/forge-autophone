<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forge_bg">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Tool Tester" android:textSize="18sp" android:textStyle="bold"
            android:textColor="@color/forge_on_surface" android:layout_marginTop="8dp" />
        <TextView
            android:id="@+id/tv_service_status"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Accessibility not active — enable in Setup"
            android:textSize="11sp" android:textColor="@color/forge_on_surface_variant"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Tool picker -->
    <Spinner
        android:id="@+id/spinner_tool"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:background="@color/forge_surface"
        android:padding="8dp"
        android:popupBackground="@color/forge_surface_variant"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Arg input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_arg"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:hint="Argument"
        app:boxStrokeColor="@color/forge_border"
        app:hintTextColor="@color/forge_on_surface_variant"
        app:layout_constraintTop_toBottomOf="@id/spinner_tool"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_arg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/forge_on_surface"
            android:fontFamily="monospace"
            android:inputType="text"
            android:imeOptions="actionDone" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Run button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_run"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:text="@string/btn_run"
        android:textSize="15sp"
        android:enabled="false"
        app:backgroundTint="@color/forge_orange"
        app:layout_constraintTop_toBottomOf="@id/til_arg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Progress indicator -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/btn_run"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Output label -->
    <TextView
        android:id="@+id/tv_output_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Output"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/forge_on_surface_variant"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/progress_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Output scroll -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_output_label"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textColor="@color/forge_on_surface_variant"
            android:background="@color/forge_surface"
            android:padding="12dp"
            android:hint="@string/tool_tester_hint"
            android:lineSpacingExtra="3dp" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
