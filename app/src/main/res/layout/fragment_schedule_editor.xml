<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forge_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Toolbar row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="8dp" android:layout_marginBottom="20dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp" android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:contentDescription="Back"
                android:layout_marginEnd="8dp" />

            <TextView android:id="@+id/tv_title"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="New schedule" android:textSize="18sp" android:textStyle="bold"
                android:textColor="@color/forge_on_surface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Delete" android:textColor="@color/forge_red"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Name field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_name"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Schedule name"
            app:boxStrokeColor="@color/forge_border"
            app:hintTextColor="@color/forge_on_surface_variant">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_name"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/forge_on_surface"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Trigger type toggle -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="TRIGGER TYPE" android:textSize="10sp" android:textStyle="bold"
            android:textColor="@color/forge_on_surface_variant" android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rg_trigger_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rb_time"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1"
                android:text="⏰  Time"
                android:textColor="@color/forge_on_surface"
                android:button="@null"
                android:gravity="center"
                android:background="@drawable/bg_radio_left"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rb_event"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1"
                android:text="⚡  Event"
                android:textColor="@color/forge_on_surface"
                android:button="@null"
                android:gravity="center"
                android:background="@drawable/bg_radio_right" />
        </RadioGroup>

        <!-- TIME trigger fields -->
        <LinearLayout
            android:id="@+id/layout_time_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="8dp"
                    android:hint="Hour (0–23)"
                    app:boxStrokeColor="@color/forge_border"
                    app:hintTextColor="@color/forge_on_surface_variant">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_hour"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/forge_on_surface"
                        android:inputType="number" android:maxLength="2"
                        android:text="08" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Minute (0–59)"
                    app:boxStrokeColor="@color/forge_border"
                    app:hintTextColor="@color/forge_on_surface_variant">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_minute"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/forge_on_surface"
                        android:inputType="number" android:maxLength="2"
                        android:text="00" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Repeat" android:textSize="12sp"
                android:textColor="@color/forge_on_surface_variant"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinner_repeat"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:background="@color/forge_surface"
                android:padding="12dp"
                android:popupBackground="@color/forge_surface_variant"
                android:layout_marginBottom="16dp" />
        </LinearLayout>

        <!-- EVENT trigger fields -->
        <LinearLayout
            android:id="@+id/layout_event_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Trigger event" android:textSize="12sp"
                android:textColor="@color/forge_on_surface_variant"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinner_event"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:background="@color/forge_surface"
                android:padding="12dp"
                android:popupBackground="@color/forge_surface_variant"
                android:layout_marginBottom="16dp" />
        </LinearLayout>

        <!-- Action plan -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="ACTION PLAN" android:textSize="10sp" android:textStyle="bold"
            android:textColor="@color/forge_on_surface_variant" android:letterSpacing="0.1"
            android:layout_marginBottom="4dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Describe in plain English what Forge OS should do when this trigger fires."
            android:textSize="11sp" android:textColor="@color/forge_on_surface_muted"
            android:lineSpacingExtra="2dp" android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_plan"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="e.g. Open Gmail, read new emails, reply to Alex"
            app:boxStrokeColor="@color/forge_orange"
            app:hintTextColor="@color/forge_on_surface_variant">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_plan"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/forge_on_surface"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="4" android:maxLines="8"
                android:gravity="top" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Save button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Save schedule"
            android:textSize="15sp"
            app:backgroundTint="@color/forge_orange" />

    </LinearLayout>
</ScrollView>
