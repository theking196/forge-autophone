<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/forge_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/forge_border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top row: name + enable toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/forge_on_surface" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_enabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/switch_thumb_color"
                app:trackTint="@color/switch_track_color" />
        </LinearLayout>

        <!-- Trigger label (e.g. "08:00 · Weekdays") -->
        <TextView
            android:id="@+id/tv_trigger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/forge_orange"
            android:fontFamily="monospace"
            android:layout_marginBottom="6dp" />

        <!-- Live "Running…" chip — visible only while Forge OS is executing -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_running"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Running…"
            android:textSize="11sp"
            android:textColor="@color/forge_bg"
            android:visibility="gone"
            app:chipBackgroundColor="@color/forge_orange"
            app:chipIcon="@drawable/ic_running"
            app:chipIconTint="@color/forge_bg"
            app:chipIconSize="14dp"
            android:layout_marginBottom="6dp" />

        <!-- Action plan preview -->
        <TextView
            android:id="@+id/tv_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/forge_on_surface_variant"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="10dp" />

        <!-- Bottom row: last run info + run count + Run-now button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_last_run"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="@color/forge_on_surface_variant" />

                <TextView
                    android:id="@+id/tv_run_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="@color/forge_on_surface_muted" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_run_now"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Run now"
                android:textSize="11sp"
                app:strokeColor="@color/forge_green"
                android:textColor="@color/forge_green" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
